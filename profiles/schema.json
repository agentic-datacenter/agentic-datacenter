        "for_each": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "For Each"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "instance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance"
        },
        "instances": {
          "anyOf": [
            {
              "items": {
                "type": "string"
