        "consumer": {
          "title": "Consumer",
          "type": "string"
        },
        "for_each": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "For Each"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "with": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "With"
        }
      },
      "required": [
        "consumer",
        "provider"
      ],
      "title": "ConnectionRule",
      "type": "object"
    },
    "ModuleUse": {
      "additionalProperties": false,
