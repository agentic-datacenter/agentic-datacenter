{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "static"
          },
          {
            "context": "unit (agentic-datacenter-core)"
          },
          {
            "context": "unit (agentic-datacenter-data)"
          },
          {
            "context": "unit (agentic-datacenter-governance)"
          },
          {
            "context": "unit (agentic-datacenter-net)"
          },
          {
            "context": "unit (agentic-datacenter-plant)"
          },
          {
            "context": "unit (agentic-datacenter-scenarios)"
          },
          {
            "context": "unit (agentic-datacenter-supervisory)"
          },
          {
            "context": "unit (agentic-datacenter-whatif)"
          },
          {
            "context": "property"
          },
          {
            "context": "conformance"
          },
          {
            "context": "traceability"
          },
          {
            "context": "docs"
          },
          {
            "context": "supply-chain"
          }
        ]
      }
    }
  ]
}
